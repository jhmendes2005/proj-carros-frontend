{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:backend": "npm run build --workspace @carros/backend",
    "predev": "npm run build:backend",
    "prebuild": "npm run build:backend",
    "postinstall": "npm run prisma:generate --workspace @carros/backend",
    "db:generate": "npm run prisma:generate --workspace @carros/backend",
    "db:migrate": "npm run prisma:migrate --workspace @carros/backend",
    "test:api": "npm run build:backend && node --test backend/test/serverless-smoke.cjs"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.553.0",
    "next": "16.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "swiper": "^12.0.3",
    "@carros/backend": "file:backend"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5"
  },
  "workspaces": [
    "backend"
  ],
  "engines": {
    "node": "22.x"
  }
}
